# ---- Discord ----
# Bot token and application ID from the Discord Developer Portal (this bot's own application)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# The Ares server the bot moderates
DISCORD_GUILD_ID=
# The staff server, where ticket channels are created (sorted into General / Report / Bug Report / Question / Staff Help
# categories, made automatically). Leave empty to use the main server.
STAFF_GUILD_ID=
DATABASE_PATH=./data/moderation.sqlite

# ---- Staff and channels ----
# Members with this role count as staff (Administrator always does). Required for mod commands and report buttons.
STAFF_ROLE_ID=
# Where mod actions, deleted/edited messages, joins/leaves and ticket transcripts are logged
LOG_CHANNEL_ID=
# Where website reports are posted with Resolved / Close buttons. Can be in another server the bot is in.
REPORTS_CHANNEL_ID=
# Where ticket transcripts go (defaults to LOG_CHANNEL_ID)
TICKET_LOG_CHANNEL_ID=

# ---- Website (aresfleet.com) ----
WEBSITE_URL=https://aresfleet.com
# Key from the website owner (the website's MOD_BOT_KEY)
MOD_BOT_KEY=

# ---- Automod (all optional) ----
# Messages per window before a spam timeout (default 6 messages in 8 seconds)
AUTOMOD_SPAM_COUNT=6
AUTOMOD_SPAM_SECONDS=8
# Timeout length in minutes for spam and mass mentions (default 10)
AUTOMOD_TIMEOUT_MINUTES=10
# Delete Discord invite links from non-staff (default on)
AUTOMOD_BLOCK_INVITES=true
# Delete all links from non-staff except the allowed domains (default off)
AUTOMOD_BLOCK_LINKS=false
AUTOMOD_ALLOWED_DOMAINS=aresfleet.com,youtube.com,youtu.be,medal.tv,tenor.com
# Mentions in one message that count as mass-pinging (default 5)
AUTOMOD_MAX_MENTIONS=5
